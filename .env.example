# Server only. Start locally with no keys. Fill only the blocks you enable.
# Settings for examples/payments.mjs. Use sandbox with test credentials or live with production credentials.
PAYMENT_MODE=mock
PAYMENT_GATEWAYS=khalti
# All seven: khalti,esewa,connectips,hamropay,nepalpay,fonepay,bankcard

# Khalti merchant dashboard
KHALTI_SECRET_KEY=

# eSewa ePay merchant credentials
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=

# connectIPS creditor credentials. Register your success and failure URLs with NCHL.
CIPS_MERCHANT_ID=
CIPS_APP_ID=
CIPS_APP_NAME=
CIPS_PASSWORD=
CIPS_PFX_PATH=
CIPS_PFX_PASSWORD=
# Optional PEM file instead of PFX; optional base URL supplied by NCHL.
CIPS_PRIVATE_KEY_PATH=
CIPS_BASE_URL=

# Hamro Pay merchant portal, Client Credentials
HAMROPAY_MERCHANT_ID=
HAMROPAY_CLIENT_ID=
HAMROPAY_CLIENT_API_KEY=
HAMROPAY_CLIENT_SECRET=
# Required for signed webhooks. Copy after registering your HTTPS webhook URL.
HAMROPAY_WEBHOOK_SECRET=
# Required in live mode. Use the two HTTPS base URLs from Hamro Pay.
HAMROPAY_API_BASE=
HAMROPAY_GATEWAY_BASE=

# NEPALPAY Dynamic QR enrollment. Use full HTTPS endpoint URLs, including the API paths.
NQR_GENERATE_URL=
NQR_REPORT_URL=
NQR_USER=
NQR_PASSWORD=
NQR_ACQUIRER=
NQR_MERCHANT=
NQR_NAME=
NQR_CATEGORY=
NQR_CITY=
NQR_POSTAL_CODE=
NQR_STORE=
NQR_PFX_PATH=
NQR_PFX_PASSWORD=
# Optional PEM file instead of PFX.
NQR_PRIVATE_KEY_PATH=
# Optional full Authorization header for separately provisioned reporting access.
NQR_REPORT_AUTHORIZATION=

# Fonepay Dynamic QR API credentials from Fonepay or your acquiring bank
FONEPAY_CODE=
FONEPAY_USER=
FONEPAY_PASSWORD=
FONEPAY_SECRET=

# Bank-provisioned Cybersource Secure Acceptance Hosted Checkout profile for NPR sales
CARD_PROFILE_ID=
CARD_ACCESS_KEY=
CARD_SECRET_KEY=
