{
  "name": "neppayments",
  "version": "2.0.8",
  "description": "Khalti and eSewa payment gateway integration for Node.js and TypeScript (Nepal). One API to create, verify and check payments, with amount checks and errors that never leak your secret key.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.cjs",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "npm run build"
  },
  "keywords": [
    "nepal",
    "nepali",
    "payment",
    "payment-gateway",
    "khalti",
    "khalti-payment",
    "khalti-integration",
    "esewa",
    "esewa-payment",
    "esewa-integration",
    "esewa-v2",
    "epay",
    "nodejs",
    "typescript",
    "express",
    "nextjs",
    "nestjs",
    "npr",
    "fintech"
  ],
  "author": "Nischal Bhattarai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nischaljs/nepPayments.git"
  },
  "homepage": "https://github.com/nischaljs/nepPayments#readme",
  "bugs": {
    "url": "https://github.com/nischaljs/nepPayments/issues"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.1",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=14.0.0"
  }
}
